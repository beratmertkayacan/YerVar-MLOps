# Bu dosyayı .env olarak kopyala. .env asla commit edilmez.
# Değerler yervar/ayarlar.py'deki varsayılanlarla aynı; açıklamalar orada.
ISPARK_TABAN_URL=https://api.ibb.gov.tr/ispark
KULLANICI_AJANI=yervar/0.1

# Toplama
TOPLAMA_ARALIGI_SN=300
ISTEK_ZAMAN_ASIMI_SN=20
DENEME_SAYISI=5
TUR_SURE_BUTCESI_SN=150
# Geçerli tur: en az bu kadar otopark, kayıtların bu oranında zorunlu alanlar tam
EN_AZ_OTOPARK=200
ZORUNLU_ALAN_ORANI=0.9
# Geçersiz yanıtın hatali/ altına saklanacak en büyük boyutu
HATALI_GOVDE_EN_FAZLA_BAYT=1000000

# Depo: "yerel" (varsayılan) veya "blob"
DEPO_TURU=yerel
VERI_KOK=veri
AZURE_DEPOLAMA_HESABI=
AZURE_KAP=ham
TABLO_KAP=tablo

# Gece tablo işi (L1)
ATLANAN_DOSYA_ORANI_EN_FAZLA=0.05
TAMAMLAMA_GUN=7
EN_FAZLA_GUN=4
TABLO_SURE_BUTCESI_SN=1200
GUN_EKSIK_ESIGI=95

# Kod sürümü: imajda Dockerfile yazar, yerelde "yerel" kalsın
KOD_SURUMU=yerel

LOG_SEVIYESI=INFO
